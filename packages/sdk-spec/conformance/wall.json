  "loader": [
    {
      "name": "requests within 50 ms share one batch, sent when the window closes, in the order asked",
      "steps": [
        {
          "load": ["u1"],
          "id": "a"
        },
        {
          "advance": 30
        },
        {
          "load": ["u2", "post_1"],
          "id": "b"
        },
        {
          "advance": 19
        },
        {
          "load": ["u3"],
          "id": "c"
        },
        {
          "expect": {
            "batches": [],
            "waiting": ["a", "b", "c"]
          }
        },
        {
          "advance": 1
        },
        {
          "expect": {
            "batches": [
              [
                {
                  "receiver": "u1"
                },
                {
                  "receiver": "u2",
                  "reference": "post_1"
                },
                {
                  "receiver": "u3"
                }
              ]
            ],
            "waiting": ["a", "b", "c"]
          }
        },
        {
          "respond": {
            "batch": 1,
            "walls": [
