                "method": "getLeaderboard",
                "args": {
                  "board": "senders",
                  "query": {
                    "period": "week",
                    "metric": "units",
                    "limit": 10
                  }
                }
              }
            ]
          }
        },
        {
          "resolve": {
            "method": "getLeaderboard",
            "value": "weekUnits"
