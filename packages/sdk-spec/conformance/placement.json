{
  "description": "Web tray placement (spec section 9.3, web only). resolve: resolveTrayPlacement(input) must equal expect. popover: positionPopover(input) must deep-equal expect (defaults gap 8, margin 8, maxHeightFraction 0.7).",
  "resolve": [
    {
      "name": "auto, 599 px with an anchor: sheet",
      "input": {
        "placement": "auto",
        "containerWidth": 599,
        "hasAnchor": true
      },
      "expect": "sheet"
    },
    {
      "name": "auto, exactly 600 px with an anchor: popover (the threshold is inclusive)",
      "input": {
        "placement": "auto",
        "containerWidth": 600,
        "hasAnchor": true
      },
      "expect": "popover"
    },
    {
      "name": "auto, exactly 600 px without an anchor: inline",
      "input": {
        "placement": "auto",
        "containerWidth": 600,
        "hasAnchor": false
      },
      "expect": "inline"
    },
    {
      "name": "auto, 599 px without an anchor: sheet",
      "input": {
        "placement": "auto",
        "containerWidth": 599,
        "hasAnchor": false
      },
      "expect": "sheet"
    },
    {
      "name": "placement not given means auto: 1100 px with an anchor",
      "input": {
        "containerWidth": 1100,
        "hasAnchor": true
      },
      "expect": "popover"
    },
    {
      "name": "an unknown placement means auto",
      "input": {
        "placement": "dock",
        "containerWidth": 1100,
        "hasAnchor": false
      },
      "expect": "inline"
    },
    {
      "name": "auto, width 0 (not laid out yet): sheet",
      "input": {
        "placement": "auto",
        "containerWidth": 0,
        "hasAnchor": true
      },
      "expect": "sheet"
    },
    {
      "name": "auto, width not a number counts as 0: sheet",
      "input": {
        "placement": "auto",
        "containerWidth": null,
        "hasAnchor": true
      },
      "expect": "sheet"
    },
    {
      "name": "auto, negative width counts as 0: sheet",
      "input": {
        "placement": "auto",
        "containerWidth": -50,
        "hasAnchor": false
      },
      "expect": "sheet"
    },
    {
      "name": "sheet is kept on a wide container",
      "input": {
        "placement": "sheet",
        "containerWidth": 1100,
        "hasAnchor": true
      },
      "expect": "sheet"
    },
    {
      "name": "inline is kept on a narrow container",
      "input": {
        "placement": "inline",
        "containerWidth": 300,
        "hasAnchor": true
      },
      "expect": "inline"
    },
    {
      "name": "popover is kept on a narrow container when there is an anchor",
      "input": {
        "placement": "popover",
        "containerWidth": 300,
        "hasAnchor": true
      },
      "expect": "popover"
    },
    {
      "name": "popover without an anchor has nothing to open from: inline",
      "input": {
        "placement": "popover",
        "containerWidth": 1100,
        "hasAnchor": false
      },
      "expect": "inline"
    }
  ],
  "popover": [
