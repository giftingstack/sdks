{
  "name": "@giftingstack/sdk",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "description": "Gift tray and effects for apps that use GiftingStack: shared recipes, a small API client, React Native components and a framework-free web player.",
  "keywords": [
    "giftingstack",
    "virtual-gifts",
    "gifting",
    "gift-tray",
    "effects",
    "react-native",
    "web-components",
    "livestream-gifts"
  ],
  "homepage": "https://giftingstack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giftingstack/sdks.git",
    "directory": "packages/sdk-js"
  },
  "bugs": {
    "url": "https://github.com/giftingstack/sdks/issues"
  },
  "sideEffects": [
    "./dist/elements.js",
    "./dist/react-native.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/types/web/index.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./react-native": {
      "types": "./dist/types/react-native/index.d.ts",
      "import": "./dist/react-native.js",
      "default": "./dist/react-native.js"
    },
    "./elements": {
      "types": "./dist/types/web/elements-register.d.ts",
      "import": "./dist/elements.js",
      "default": "./dist/elements.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs && vite build --config vite.build.config.ts",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build",
    "demo": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/site.vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.87.1",
    "react-native-web": "^0.21.4",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
